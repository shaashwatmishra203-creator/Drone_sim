# Raw simulator noise — regenerate by re-running a scenario.
# The flight-log CSVs ARE kept: they are the evidence behind the results.
out/runs/*/px4.log
out/runs/*/agent.log
out/runs/*/logger.log
out/runs/*/runner.log
out/runs/*/wind.log
*.ulg
log/

# Generated models and airframes — reproduce with tools/gen_model.py.
# The v1 report PDF is a deliverable; keep it.
!out/*.pdf
out/generated/

# Scratch / isolation scenarios and their runs
scenarios/_*.yaml
out/runs/hover_test_*/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# v2 factory hall
# videos are 13 MB per run; docs/replay/frames show the same views
out/runs/*/detections.mp4
out/runs/hall_latest
# run 13: two harnesses overlapped on this folder - excluded from results
out/runs/hall_mission/
out/runs/*/cloud_link.log
